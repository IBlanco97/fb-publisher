# ─── Facebook Login (para Playwright) ───
# Opcionales: el método recomendado es login manual con `npm run cli -- login`
FB_EMAIL=
FB_PASSWORD=

# ─── Playwright ───
PLAYWRIGHT_HEADLESS=true

# ─── Publicación ───
RETRY_ATTEMPTS=2
RETRY_DELAY_MS=5000

# ─── Comportamiento anti-detección (scheduler) ───
# Estos 5 valores solo se usan UNA VEZ, para sembrar la configuración inicial
# la primera vez que arranca la aplicación. Después de eso viven en la base de
# datos y se editan desde el dashboard (Configuración → "Ritmo de publicación
# y anti-detección") — cambiarlos acá ya no tiene efecto en una instalación
# que ya arrancó antes.
SCHEDULER_JITTER_MIN_MINUTES=0
SCHEDULER_JITTER_MAX_MINUTES=20
SCHEDULER_GLOBAL_MIN_GAP_MINUTES=8
SCHEDULER_MAX_POSTS_PER_DAY_TOTAL=12
SCHEDULER_CROSS_ACCOUNT_MIN_GAP_MINUTES=3

# ─── Facebook Login (para Playwright) ───
# Opcionales: el método recomendado es login manual con `npm run cli -- login`
FB_EMAIL=
FB_PASSWORD=

# ─── Playwright ───
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_USER_DATA_DIR=./data/browser-session

# ─── Publicación ───
RETRY_ATTEMPTS=2
RETRY_DELAY_MS=5000

# ─── Comportamiento anti-detección (scheduler) ───
# Jitter: espera aleatoria (minutos) tras cada disparo de cron antes de publicar,
# para no publicar siempre a la misma hora exacta.
SCHEDULER_JITTER_MIN_MINUTES=0
SCHEDULER_JITTER_MAX_MINUTES=20
# Espaciado mínimo (minutos) entre CUALQUIER par de posts DE LA MISMA CUENTA, sin importar el grupo.
SCHEDULER_GLOBAL_MIN_GAP_MINUTES=8
# Tope diario de publicaciones exitosas POR CUENTA (además del límite por grupo).
SCHEDULER_MAX_POSTS_PER_DAY_TOTAL=12
# Espaciado mínimo (minutos) entre posts de CUENTAS DISTINTAS — evita que dos cuentas
# publiquen en el mismo instante aunque cada una tenga su propio proxy.
SCHEDULER_CROSS_ACCOUNT_MIN_GAP_MINUTES=3
